# Copy to .env (never committed). Without it the server uses the offline copy in data/.
# Both values are on the project's Connect dialog in the Supabase dashboard.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Passport Assistant (optional). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
